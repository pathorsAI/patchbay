{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "patchbay",
  "version": "0.4.0",
  "identifier": "com.pathors.patchbay",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1425",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "patchbay",
        "width": 1040,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pathorsAI/patchbay/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzQUZFMUYzRTRBRUQ4OTUKUldTVjJLN2s4K0d2ODNnSDBIRGV0TGNnaDJMVVFoWlpmeHJpYnY5TlR3R2ZjME94ME8xZm1MVm4K"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
